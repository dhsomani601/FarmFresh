# FreshMart Server Environment Configuration
PORT=3001
JWT_SECRET=freshmart_secure_jwt_secret_token_2026

# ====================================================================
# Real Email Delivery Configuration (Optional)
# If left empty, OTPs are safely logged to console and displayed for testing.
# When provided, real HTML verification emails are delivered to user inboxes.
# ====================================================================

# Gmail Example (Generate App Password via Google Account -> Security -> 2-Step Verification -> App passwords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="FreshMart Organics" <your-email@gmail.com>

# Brevo / SendGrid / Custom SMTP Example:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@smtp-brevo.com
# SMTP_PASS=your-brevo-master-key
